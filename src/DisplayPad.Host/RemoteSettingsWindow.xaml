<Window x:Class="DisplayPad.Host.RemoteSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DlgRemoteTitle}" Width="420" SizeToContent="Height"
        Background="#1E1E1E" Foreground="#EEEEEE"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="{DynamicResource LblRemoteHost}" Margin="0,0,0,3"/>
        <TextBox x:Name="HostBox" Margin="0,0,0,10"/>
        <TextBlock Text="{DynamicResource LblRemotePort}" Margin="0,0,0,3"/>
        <TextBox x:Name="PortBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <TextBlock Text="{DynamicResource LblRemoteToken}" Margin="0,0,0,3"/>
        <TextBox x:Name="TokenBox" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource BtnCancel}" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource BtnSave}" Click="Save_Click" FontWeight="Bold"/>
        </StackPanel>
    </StackPanel>
</Window>