<Window x:Class="DisplayPad.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DisplayPad.Host.ViewModels"
        xmlns:models="clr-namespace:DisplayPad.Shared.Models;assembly=DisplayPad.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{DynamicResource AppTitle}" Height="720" Width="1100"
        MinHeight="640" MinWidth="980" ResizeMode="CanResize"
        Background="{DynamicResource ThemeWindowBackground}" Foreground="{DynamicResource ThemeTextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeSoftTextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00D4E8"/>
            <Setter Property="SelectionBrush" Value="#00D4E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4E8"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeStrongBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePressedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border Width="30" HorizontalAlignment="Right"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,0,0,0"/>
                                            <Path Width="8" Height="5" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,11,0"
                                                  Fill="{DynamicResource ThemeArrowBrush}" Stretch="Fill"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="9,0,34,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="9,0,34,0"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ThemeControlBackground}"
                                        BorderBrush="{DynamicResource ThemeStrongBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeStrongBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#00D4E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="ContentSite" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="18" Height="18">
                                    <Border x:Name="Box" Background="{DynamicResource ThemeControlBackground}" BorderBrush="{DynamicResource ThemeStrongBorderBrush}"
                                            BorderThickness="1" CornerRadius="4"/>
                                    <Path x:Name="Check" Data="M 4 9 L 8 13 L 15 5"
                                          Stroke="#071417" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#00D4E8"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#00D4E8"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#00D4E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="6,6,0,0" Background="Transparent"/>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceBackground}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5,5,0,0"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0,2,0">
                                <ContentPresenter x:Name="Content"
                                                  ContentSource="Header"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <Border x:Name="Indicator" Height="2"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeSurfaceBackground}"/>
                                <Setter TargetName="Indicator" Property="Background" Value="#00D4E8"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource ThemeSoftTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource ThemeTabHoverTextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,14">

            <!-- ═══════════════════════════════════════════ Tab 1: DisplayPad ═══════ -->
            <TabItem Header="{DynamicResource TabDisplayPad}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="370"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tastenraster 6x2 -->
                    <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackground}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Profil-Zeile -->
                                <DockPanel Margin="2,0,0,8">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse Width="7" Height="7" Fill="#00D4E8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource LblProfile}" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ComboBox Width="130" ItemsSource="{Binding Profiles}"
                                                  SelectedItem="{Binding ActiveProfile}" Margin="0,0,6,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Width="110" Text="{Binding ActiveProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource TtpProfileName}" Margin="0,0,6,0"/>
                                        <Button Content="+" Command="{Binding AddProfileCommand}" Padding="9,5"
                                                Margin="0,0,4,0" ToolTip="{DynamicResource TtpAddProfile}"/>
                                        <Button Content="⧉" Command="{Binding DuplicateProfileCommand}" Padding="9,5"
                                                Margin="0,0,4,0" ToolTip="{DynamicResource TtpDuplicateProfile}"/>
                                        <Button Content="–" Command="{Binding RemoveProfileCommand}" Padding="9,5"
                                                Margin="0,0,6,0" ToolTip="{DynamicResource TtpRemoveProfile}"/>
                                        <Button Content="↑" Command="{Binding ExportProfileCommand}" Padding="9,5"
                                                Margin="0,0,4,0" ToolTip="{DynamicResource TtpExportProfile}"/>
                                        <Button Content="↓" Command="{Binding ImportProfileCommand}" Padding="9,5"
                                                ToolTip="{DynamicResource TtpImportProfile}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Seiten-Zeile -->
                                <DockPanel Margin="2,0,0,12">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#00D4E8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource LblKeys}" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,0,10,0"/>
                                        <ComboBox Width="130" ItemsSource="{Binding Pages}"
                                                  SelectedItem="{Binding ActivePage}" Margin="0,0,6,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Width="110" Text="{Binding ActivePage.Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource TtpPageName}" Margin="0,0,6,0"/>
                                        <Button Content="+" Command="{Binding AddPageCommand}" Padding="9,5"
                                                Margin="0,0,4,0" ToolTip="{DynamicResource TtpAddPage}"/>
                                        <Button Content="–" Command="{Binding RemovePageCommand}" Padding="9,5"
                                                Margin="0,0,4,0" ToolTip="{DynamicResource TtpRemovePage}"/>
                                        <Button Content="→" Padding="9,5" Margin="0,0,4,0"
                                                ToolTip="{DynamicResource TtpCopyPageToProfile}"
                                                Click="CopyPageToProfileButton_Click"/>
                                        <Button Content="↑" Command="{Binding ExportPageCommand}" Padding="9,5"
                                                Margin="0,0,4,0" ToolTip="{DynamicResource TtpExportPage}"/>
                                        <Button Content="↓" Command="{Binding ImportPageCommand}" Padding="9,5"
                                                ToolTip="{DynamicResource TtpImportPage}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Margin="0,0,0,8" Padding="8,5" CornerRadius="4"
                                        Background="{DynamicResource ThemeSuccessBackground}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InFolderEditor}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource BtnBack}"
                                                Command="{Binding ExitFolderEditorCommand}"
                                                Padding="8,3" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding EditorBreadcrumb}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource ThemeSuccessText}"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding EditorPage.Keys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" Rows="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:KeyViewModel}">
                                            <Button Margin="4" Height="86" Padding="3"
                                                    Click="KeyButton_Click"
                                                    BorderThickness="2">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#0D0D0D"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#00D4E8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                <Setter Property="Background" Value="#00D4E8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="6,12,0,0">
                                    <Button DockPanel.Dock="Right" Command="{Binding ToggleLearnModeCommand}"
                                            ToolTip="{DynamicResource TtpLearnMode}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="{DynamicResource BtnLearnMode}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LearnModeActive}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource BtnLearnCancel}"/>
                                                        <Setter Property="BorderBrush" Value="#F5A524"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding DeviceStatusText}" Foreground="{DynamicResource ThemeMutedTextBrush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Editor für die ausgewählte Taste -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeCardBackground}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding SelectedKey}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock FontWeight="Bold" FontSize="14"
                                               Text="{DynamicResource LblKeyPrefix}" Margin="0,0,4,0"/>
                                    <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding KeyNumber}"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource LblLabel}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="{DynamicResource LblFont}" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ComboBox Width="90" SelectedValuePath="Tag"
                                              SelectedValue="{Binding LabelPosition}" Margin="0,0,6,0"
                                              ToolTip="{DynamicResource TtpLabelPos}">
                                        <ComboBoxItem Content="{DynamicResource CbPosTop}"
                                                      Tag="{x:Static models:LabelPosition.Top}"/>
                                        <ComboBoxItem Content="{DynamicResource CbPosCenter}"
                                                      Tag="{x:Static models:LabelPosition.Center}"/>
                                        <ComboBoxItem Content="{DynamicResource CbPosBottom}"
                                                      Tag="{x:Static models:LabelPosition.Bottom}"/>
                                    </ComboBox>
                                    <TextBox Width="45" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="{DynamicResource TtpFontSize}" Margin="0,0,8,0"/>
                                    <CheckBox Content="{DynamicResource CbBold}" IsChecked="{Binding Bold}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox Content="{DynamicResource CbItalic}" IsChecked="{Binding Italic}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource LblIcon}" Margin="0,0,0,3"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="✕" Margin="4,0,0,0" Padding="8,5"
                                            Command="{Binding DataContext.ClearIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource BtnBrowse}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                </DockPanel>

                                <TextBlock Text="{DynamicResource LblAction}" Margin="0,0,0,3"/>
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActionType}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="{DynamicResource AcNone}"
                                                  Tag="{x:Static models:KeyActionType.None}"/>
                                    <ComboBoxItem Content="{DynamicResource AcHotkey}"
                                                  Tag="{x:Static models:KeyActionType.Hotkey}"/>
                                    <ComboBoxItem Content="{DynamicResource AcCommand}"
                                                  Tag="{x:Static models:KeyActionType.Command}"/>
                                    <ComboBoxItem Content="{DynamicResource AcSwitchPage}"
                                                  Tag="{x:Static models:KeyActionType.SwitchPage}"/>
                                    <ComboBoxItem Content="{DynamicResource AcObs}"
                                                  Tag="{x:Static models:KeyActionType.Obs}"/>
                                    <ComboBoxItem Content="{DynamicResource AcNvidia}"
                                                  Tag="{x:Static models:KeyActionType.Nvidia}"/>
                                    <ComboBoxItem Content="{DynamicResource AcFolder}"
                                                  Tag="{x:Static models:KeyActionType.Folder}"/>
                                </ComboBox>

                                <!-- NVIDIA-Eingabe -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.Nvidia}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LblNvidiaHint}" Margin="0,0,0,5"
                                               TextWrapping="Wrap"/>
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding NvidiaFunction}">
                                        <ComboBoxItem Content="{DynamicResource NvDvrSave}"       Tag="DVRSave"/>
                                        <ComboBoxItem Content="{DynamicResource NvDvrToggle}"     Tag="DVRToggle"/>
                                        <ComboBoxItem Content="{DynamicResource NvRecordToggle}"  Tag="RecordToggle"/>
                                        <ComboBoxItem Content="{DynamicResource NvScreenshot}"    Tag="Screenshot"/>
                                        <ComboBoxItem Content="{DynamicResource NvMicToggle}"     Tag="MicToggle"/>
                                        <ComboBoxItem Content="{DynamicResource NvOpenIgo}"       Tag="OpenIGO"/>
                                        <ComboBoxItem Content="{DynamicResource NvPmocOverlay}"   Tag="PMOCOverlay"/>
                                        <ComboBoxItem Content="{DynamicResource NvOpenAnsel}"     Tag="OpenAnsel"/>
                                        <ComboBoxItem Content="{DynamicResource NvOpenFreestyle}" Tag="OpenFreestyle"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- OBS-Eingabe -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.Obs}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LblObsCommand}" Margin="0,0,0,3"/>
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ObsCommand}"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="{DynamicResource ObsSetScene}"
                                                      Tag="{x:Static models:ObsCommand.SetScene}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleStream}"
                                                      Tag="{x:Static models:ObsCommand.ToggleStream}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStartStream}"
                                                      Tag="{x:Static models:ObsCommand.StartStream}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStopStream}"
                                                      Tag="{x:Static models:ObsCommand.StopStream}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleRecord}"
                                                      Tag="{x:Static models:ObsCommand.ToggleRecord}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStartRecord}"
                                                      Tag="{x:Static models:ObsCommand.StartRecord}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStopRecord}"
                                                      Tag="{x:Static models:ObsCommand.StopRecord}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleMute}"
                                                      Tag="{x:Static models:ObsCommand.ToggleMute}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsSaveReplayBuffer}"
                                                      Tag="{x:Static models:ObsCommand.SaveReplayBuffer}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStartReplayBuffer}"
                                                      Tag="{x:Static models:ObsCommand.StartReplayBuffer}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStopReplayBuffer}"
                                                      Tag="{x:Static models:ObsCommand.StopReplayBuffer}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleReplayBuffer}"
                                                      Tag="{x:Static models:ObsCommand.ToggleReplayBuffer}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsPauseRecord}"
                                                      Tag="{x:Static models:ObsCommand.PauseRecord}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsResumeRecord}"
                                                      Tag="{x:Static models:ObsCommand.ResumeRecord}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleRecordPause}"
                                                      Tag="{x:Static models:ObsCommand.ToggleRecordPause}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStartVirtualCam}"
                                                      Tag="{x:Static models:ObsCommand.StartVirtualCam}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsStopVirtualCam}"
                                                      Tag="{x:Static models:ObsCommand.StopVirtualCam}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleVirtualCam}"
                                                      Tag="{x:Static models:ObsCommand.ToggleVirtualCam}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsSetPreviewScene}"
                                                      Tag="{x:Static models:ObsCommand.SetPreviewScene}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsTriggerTransition}"
                                                      Tag="{x:Static models:ObsCommand.TriggerTransition}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsTriggerHotkey}"
                                                      Tag="{x:Static models:ObsCommand.TriggerHotkeyByName}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleSceneItem}"
                                                      Tag="{x:Static models:ObsCommand.ToggleSceneItem}"/>
                                        <ComboBoxItem Content="{DynamicResource ObsToggleSourceFilter}"
                                                      Tag="{x:Static models:ObsCommand.ToggleSourceFilter}"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ObsCommand}"
                                                                 Value="{x:Static models:ObsCommand.SetScene}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObsCommand}"
                                                                 Value="{x:Static models:ObsCommand.ToggleMute}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObsCommand}"
                                                                 Value="{x:Static models:ObsCommand.SetPreviewScene}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObsCommand}"
                                                                 Value="{x:Static models:ObsCommand.TriggerHotkeyByName}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObsCommand}"
                                                                 Value="{x:Static models:ObsCommand.ToggleSceneItem}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ObsCommand}"
                                                                 Value="{x:Static models:ObsCommand.ToggleSourceFilter}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Margin="0,0,0,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource LblObsParamScene}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.ToggleMute}">
                                                            <Setter Property="Text" Value="{DynamicResource LblObsParamSource}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.ToggleSourceFilter}">
                                                            <Setter Property="Text" Value="{DynamicResource LblObsParamSourceName}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.TriggerHotkeyByName}">
                                                            <Setter Property="Text" Value="{DynamicResource LblObsParamHotkeyName}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding ObsParameter, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox"
                                                       BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Setter Property="ItemsSource"
                                                            Value="{Binding DataContext.ObsSceneNames, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.ToggleMute}">
                                                            <Setter Property="ItemsSource"
                                                                    Value="{Binding DataContext.ObsInputNames, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.ToggleSourceFilter}">
                                                            <Setter Property="ItemsSource"
                                                                    Value="{Binding DataContext.ObsInputNames, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.TriggerHotkeyByName}">
                                                            <Setter Property="ItemsSource" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <!-- ObsParameter2: Quellenname oder Filtername -->
                                        <StackPanel Margin="0,6,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.ToggleSceneItem}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ObsCommand}"
                                                                     Value="{x:Static models:ObsCommand.ToggleSourceFilter}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Margin="0,0,0,3">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource LblObsParam2Source}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ObsCommand}"
                                                                         Value="{x:Static models:ObsCommand.ToggleSourceFilter}">
                                                                <Setter Property="Text" Value="{DynamicResource LblObsParam2Filter}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding ObsParameter2, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Ziel-Auswahl (nur bei Hotkey/Befehl) -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.Hotkey}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.Command}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LblExecuteOn}" Margin="0,0,0,3"/>
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Target}">
                                        <ComboBoxItem Content="{DynamicResource TgtRemote}"
                                                      Tag="{x:Static models:ActionTarget.Remote}"/>
                                        <ComboBoxItem Content="{DynamicResource TgtLocal}"
                                                      Tag="{x:Static models:ActionTarget.Local}"/>
                                        <ComboBoxItem Content="{DynamicResource TgtBoth}"
                                                      Tag="{x:Static models:ActionTarget.Both}"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Hotkey-Eingabe -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.Hotkey}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LblHotkeyHint}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="HotkeyBox"
                                             Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             ToolTip="{DynamicResource TtpHotkeyBox}"/>
                                </StackPanel>

                                <!-- Befehls-Eingabe -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.Command}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LblCommandHint}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CommandLine, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8"
                                             ToolTip="{DynamicResource TtpCommandBox}"/>
                                    <TextBlock Text="{DynamicResource LblWorkDir}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Seitenwechsel-Eingabe -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.SwitchPage}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LblPageSwitch}" Margin="0,0,0,3"/>
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding PageSwitchMode}"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="{DynamicResource PsNext}"
                                                      Tag="{x:Static models:PageSwitchMode.Next}"/>
                                        <ComboBoxItem Content="{DynamicResource PsPrev}"
                                                      Tag="{x:Static models:PageSwitchMode.Previous}"/>
                                        <ComboBoxItem Content="{DynamicResource PsGoto}"
                                                      Tag="{x:Static models:PageSwitchMode.GoTo}"/>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PageSwitchMode}"
                                                                 Value="{x:Static models:PageSwitchMode.GoTo}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{DynamicResource LblPageNumber}" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBox Width="50"
                                                 Text="{Binding TargetPage, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Ordner-Editor -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}"
                                                             Value="{x:Static models:KeyActionType.Folder}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LblFolderHint}" Margin="0,0,0,8"
                                               TextWrapping="Wrap" Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                                    <Button Content="{DynamicResource BtnEditFolder}" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenFolderEditorCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>

                                <Button Content="{DynamicResource BtnTestAction}"
                                        Command="{Binding DataContext.TestActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ Tab 2: Dienste ══════════ -->
            <TabItem Header="{DynamicResource TabServices}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card: Remote Agent -->
                    <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="16" Margin="0,0,8,0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E04040"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgentOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#4DC84D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource LblRemoteSection}" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding AgentStatusText}" Margin="0,0,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                            <Button Content="{DynamicResource BtnRemoteSettings}"
                                    Click="RemoteSettings_Click"
                                    ToolTip="{DynamicResource TtpRemoteSettings}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: OBS Studio -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="16" Margin="4,0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E04040"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ObsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#4DC84D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource LblObsSection}" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding ObsStatusText}" Margin="0,0,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                            <Button Content="{DynamicResource BtnObsSettings}"
                                    Click="ObsSettings_Click"
                                    ToolTip="{DynamicResource TtpObsSettings}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: Mountain Base Camp -->
                    <Border Grid.Column="2" Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="16" Margin="8,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4DC84D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BaseCampConflict}" Value="True">
                                                    <Setter Property="Fill" Value="#F5A524"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource LblBaseCampSection}" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding BaseCampStatusText}" Margin="0,0,0,14" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BaseCampConflict}" Value="True">
                                                <Setter Property="Foreground" Value="#F5A524"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource BtnDisableBaseCamp}"
                                        Command="{Binding DisableBaseCampCommand}"
                                        IsEnabled="{Binding BaseCampInstalled}" Margin="0,0,8,0"
                                        ToolTip="{DynamicResource TtpDisableBaseCamp}"/>
                                <Button Content="{DynamicResource BtnEnableBaseCamp}"
                                        Command="{Binding EnableBaseCampCommand}"
                                        IsEnabled="{Binding BaseCampInstalled}"
                                        ToolTip="{DynamicResource TtpEnableBaseCamp}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ Tab 3: Einstellungen ════ -->
            <TabItem Header="{DynamicResource TabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="10">
                    <StackPanel MaxWidth="500" HorizontalAlignment="Left">

                        <!-- Autostart -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="#00D4E8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblAutostartSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <CheckBox Content="{DynamicResource CbAutostartText}"
                                      IsChecked="{Binding AutostartEnabled}"/>
                        </Border>

                        <!-- Sprache / Language -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="#00D4E8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblLanguageSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag" Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="{DynamicResource LanguageGerman}" Tag="de"/>
                                <ComboBoxItem Content="{DynamicResource LanguageEnglish}" Tag="en"/>
                            </ComboBox>
                        </Border>

                        <!-- Design -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="#00D4E8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblThemeSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,16">
                            <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="dark"/>
                                <ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="light"/>
                            </ComboBox>
                        </Border>

                        <!-- Über / About -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="#00D4E8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblAboutSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource LblDeveloper}"
                                               Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource CreatorName}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource LblVersionLabel}"
                                               Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Fußzeile -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeMutedTextBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource BtnResetMappings}"
                        Command="{Binding ResetStoredMappingsCommand}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource TtpResetMappings}"/>
                <Button Content="{DynamicResource BtnSave}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource BtnUpload}" Command="{Binding UploadToDeviceCommand}"
                        Background="#00D4E8" Foreground="#071417" BorderBrush="#00D4E8"
                        Padding="14,7" MinHeight="36" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4DE4F1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#00AFC0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
