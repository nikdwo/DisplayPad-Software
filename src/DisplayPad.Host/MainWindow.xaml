                                <Button Content="{DynamicResource BtnTestAction}"
                                        Command="{Binding DataContext.TestActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"/>

                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource TabServices}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource TabServices}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <UniformGrid Columns="2">

                    <!-- Card: Remote Agent -->
                    <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="16" Margin="0,0,16,16" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E04040"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgentOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#4DC84D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource LblRemoteSection}" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding AgentStatusText}" Margin="0,0,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                            <Button Content="{DynamicResource BtnRemoteSettings}"
                                    Click="RemoteSettings_Click"
                                    ToolTip="{DynamicResource TtpRemoteSettings}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: OBS Studio -->
                    <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="16" Margin="0,0,16,16" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E04040"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ObsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#4DC84D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource LblObsSection}" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding ObsStatusText}" Margin="0,0,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                            <Button Content="{DynamicResource BtnObsSettings}"
                                    Click="ObsSettings_Click"
                                    ToolTip="{DynamicResource TtpObsSettings}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: Mountain Base Camp -->
                    <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="16" Margin="0,0,16,16" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4DC84D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BaseCampConflict}" Value="True">
                                                    <Setter Property="Fill" Value="#F5A524"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource LblBaseCampSection}" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding BaseCampStatusText}" Margin="0,0,0,14" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BaseCampConflict}" Value="True">
                                                <Setter Property="Foreground" Value="#F5A524"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel>
                                <Button Content="{DynamicResource BtnDisableBaseCamp}"
                                        Command="{Binding DisableBaseCampCommand}"
                                        IsEnabled="{Binding BaseCampInstalled}" Margin="0,0,8,0"
                                        ToolTip="{DynamicResource TtpDisableBaseCamp}"/>
                                <Button Content="{DynamicResource BtnEnableBaseCamp}"
                                        Command="{Binding EnableBaseCampCommand}"
                                        IsEnabled="{Binding BaseCampInstalled}"
                                        ToolTip="{DynamicResource TtpEnableBaseCamp}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </UniformGrid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource TabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="24">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource TabSettings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource LblDeviceSection}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceStatusText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button HorizontalAlignment="Left" Command="{Binding ToggleLearnModeCommand}"
                                            ToolTip="{DynamicResource TtpLearnMode}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="{DynamicResource BtnLearnMode}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LearnModeActive}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource BtnLearnCancel}"/>
                                                        <Setter Property="BorderBrush" Value="#F5A524"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                <Button Content="{DynamicResource BtnResetMappings}" Command="{Binding ResetStoredMappingsCommand}"
                                        ToolTip="{DynamicResource TtpResetMappings}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Autostart -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblAutostartSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <CheckBox Content="{DynamicResource CbAutostartText}"
                                      IsChecked="{Binding AutostartEnabled}"/>
                        </Border>

                        <!-- Sprache / Language -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblLanguageSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag" Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="{DynamicResource LanguageGerman}" Tag="de"/>
                                <ComboBoxItem Content="{DynamicResource LanguageEnglish}" Tag="en"/>
                            </ComboBox>
                        </Border>

                        <!-- Design -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblThemeSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                Padding="14" Margin="0,0,0,16">
                            <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="dark"/>
                                <ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="light"/>
                            </ComboBox>
                        </Border>

                        <!-- Über / About -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource LblAboutSection}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource LblDeveloper}"
                                               Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource CreatorName}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource LblVersionLabel}"
                                               Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="54" Margin="0,0,20,0"
                           ToolTip="{Binding StatusMessage}" Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource BtnSave}" Command="{Binding SaveCommand}" MinWidth="110" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource BtnUpload}" Command="{Binding UploadToDeviceCommand}" Background="{DynamicResource ThemeAccentBrush}"
                            Foreground="{DynamicResource ThemeAccentTextBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" Padding="18,7" MinHeight="36" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="UploadBackground" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="UploadBackground" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="UploadBackground" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="UploadBackground" Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
