<Window x:Class="DisplayPad.Host.ObsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OBS WebSocket" Width="420" SizeToContent="Height"
        Background="#141414" Foreground="#EBEBEB"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EBEBEB"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#EBEBEB"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CaretBrush" Value="#00D4E8"/>
            <Setter Property="SelectionBrush" Value="#00D4E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#EBEBEB"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CaretBrush" Value="#00D4E8"/>
            <Setter Property="SelectionBrush" Value="#00D4E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#EBEBEB"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#282828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#004D5A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#1C1C1C" CornerRadius="8" BorderBrush="#2C2C2C" BorderThickness="1" Margin="14">
        <StackPanel Margin="14">
            <TextBlock TextWrapping="Wrap" Foreground="#7A7A7A" Margin="0,0,0,10"
                       Text="{DynamicResource DlgObsHint}"/>
            <TextBlock Text="{DynamicResource LblObsHostField}" Margin="0,0,0,3"/>
            <TextBox x:Name="HostBox" Margin="0,0,0,10"/>
            <TextBlock Text="{DynamicResource LblRemotePort}" Margin="0,0,0,3"/>
            <TextBox x:Name="PortBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>
            <TextBlock Text="{DynamicResource LblObsPasswordField}" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>
            <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#7A7A7A"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" Content="{DynamicResource BtnTestConn}" Click="Test_Click" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource BtnCancel}" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource BtnSave}" Click="Save_Click" FontWeight="Bold"
                        BorderBrush="#00D4E8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
