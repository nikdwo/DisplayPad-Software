<Window x:Class="DisplayPad.Host.ObsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OBS WebSocket" Width="420" SizeToContent="Height"
        Background="#1E1E1E" Foreground="#EEEEEE"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" Margin="0,0,0,10"
                   Text="{DynamicResource DlgObsHint}"/>
        <TextBlock Text="{DynamicResource LblObsHostField}" Margin="0,0,0,3"/>
        <TextBox x:Name="HostBox" Margin="0,0,0,10"/>
        <TextBlock Text="{DynamicResource LblRemotePort}" Margin="0,0,0,3"/>
        <TextBox x:Name="PortBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <TextBlock Text="{DynamicResource LblObsPasswordField}" Margin="0,0,0,3"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>
        <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#AAAAAA"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestButton" Content="{DynamicResource BtnTestConn}" Click="Test_Click" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource BtnCancel}" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource BtnSave}" Click="Save_Click" FontWeight="Bold"/>
        </StackPanel>
    </StackPanel>
</Window>
